# Copy this file to .env and fill it in. Never commit .env.

OPENAI_API_KEY=
# OPENROUTER_API_KEY=                          # optional: open models via openrouter:<model>
# OLLAMA_BASE_URL=http://localhost:11434/v1     # optional: local models via ollama:<model>

# Models to compare, as provider:model (a bare name means OpenAI). Run `ranklab models` to see names.
RANKLAB_MODELS=
# The judge: ideally stronger than the contestants, and not one of them.
RANKLAB_JUDGE_MODEL=
